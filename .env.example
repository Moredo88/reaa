# Copie para .env.local e preencha com os valores do projeto Supabase do REAA.
# .env.local esta no .gitignore e nunca deve ser commitado.

# Painel do Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servico: ignora RLS. So e usada no servidor (rotas /api/admin).
# Em producao ela vem das variaveis do Coolify, nunca dos secrets do GitHub.
SUPABASE_SERVICE_ROLE_KEY=
